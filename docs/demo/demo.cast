[4.32, "o", "\u001b[32m[I]\u001b[0m Trial 4/10: R\u00b2=0.8324 (GBR n_est=258 depth=5 lr=0.02)\r\n"]
[4.62, "o", "\u001b[32m[I]\u001b[0m Trial 5/10: R\u00b2=0.8081 (GBR n_est=126 depth=8 lr=0.04)\r\n"]
[4.92, "o", "\u001b[32m[I]\u001b[0m Trial 6/10: R\u00b2=\u001b[1m0.8392\u001b[0m \u2b50 (GBR n_est=203 depth=4 lr=0.03)\r\n"]
[5.22, "o", "\u001b[32m[I]\u001b[0m Trial 7/10: R\u00b2=0.8101 (GBR n_est=150 depth=6 lr=0.05)\r\n"]
