[2.52, "o", "\r\n$ scomp-link tune --data train.csv --target price --task regression --method optuna --n-trials 10 --save-artifact model.scomp\r\n"]
[3.42, "o", "\u001b[32m[I]\u001b[0m Trial 1/10: R\u00b2=0.7842 (GBR n_est=144 depth=12 lr=0.12)\r\n"]
