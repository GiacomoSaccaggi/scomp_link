[6.12, "o", "\u001b[32m[I]\u001b[0m Trial 10/10: R\u00b2=0.8201 (GBR n_est=180 depth=7 lr=0.02)\r\n"]
[6.52, "o", "\u001b[1m\u2705 Best: R\u00b2=0.8392 | Saved: model.scomp\u001b[0m\r\n"]
[8.07, "o", "\r\n$ scomp-link validate --artifact model.scomp --data test.csv --target price\r\n"]
[8.72, "o", "Metric          Value\r\n"]
[8.74, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n"]
[8.79, "o", "R\u00b2              0.8392\r\n"]
[8.84, "o", "RMSE         24156.43\r\n"]
[8.89, "o", "MAE          18234.67\r\n"]
[8.94, "o", "MAPE            6.41%\r\n"]
[8.96, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n"]
[9.01, "o", "\u2705 Model performs within acceptable thresholds.\r\n"]
[10.56, "o", "\r\n$ scomp-link report --artifact model.scomp --data test.csv --output report.html\r\n"]
[11.46, "o", "\u2705 Report saved: report.html (with code blocks + diff view)\r\n"]
[12.48, "o", "\r\n$ python -c \"\r\n"]
[12.52, "o", "from scomp_link import CodeStep, DiffStep, SectionStep, SaveStep\r\n"]
[12.56, "o", "from scomp_link.utils.report_html import ScompLinkHTMLReport\r\n"]
[12.6, "o", "report = ScompLinkHTMLReport('Code Review')\r\n"]
[12.62, "o", "(\r\n"]
[12.66, "o", "    SectionStep('Changes') \r\n"]
[12.7, "o", "    >> CodeStep('model.fit(X, y)', 'python', 'Training')\r\n"]
[12.74, "o", "    >> DiffStep('alpha=1.0', 'n_estimators=200', 'python', 'Upgrade')\r\n"]
[12.78, "o", "    >> SaveStep('review.html')\r\n"]
[12.82, "o", ").run(report)\r\n"]
[12.84, "o", "\"\r\n"]
[13.44, "o", "\u2705 Report saved: review.html\r\n"]
[14.99, "o", "\r\n\u001b[1;33m\ud83c\udf1f From CSV to model + report in 30 seconds.\u001b[0m\r\n"]
[15.04, "o", "\u001b[1;36m   pip install scomp-link\u001b[0m\r\n"]
